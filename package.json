{
    "name": "@ts-core/crypto-metamask-backend",
    "version": "3.1.3",
    "description": "Server-side TypeScript library for Ethereum/Metamask signature verification and signing using Keccak algorithm (EIP-191)",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/common": "~3.0.57",
        "@metamask/eth-sig-util": "^5.1.0"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-crypto-metamask-backend.git"
    },
    "keywords": [
        "typescript",
        "metamask",
        "ethereum",
        "signature",
        "verification",
        "keccak",
        "eip-191",
        "web3",
        "backend",
        "ts-core"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/ts-core-crypto-metamask-backend/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/ts-core-crypto-metamask-backend#readme"
}
